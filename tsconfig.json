{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "middleware.ts",
    "instrumentation.ts",
    "proxy.ts",
    "next.config.ts",
    "prisma.config.ts",
    "tailwind.config.ts",
    "vitest.config.ts",
    "vitest.setup.ts",
    "vitest.global-setup.ts",
    "playwright.config.ts",
    "playwright.visual.config.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "lib/**/*.ts",
    "lib/**/*.tsx",
    "types/**/*.ts",
    "utils/**/*.ts",
    "config/**/*.ts",
    "core/**/*.ts",
    "emails/**/*.ts",
    "emails/**/*.tsx",
    "services/**/*.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "agents/**/*.ts",
    "prisma/**/*.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "out",
    "build",
    "coverage",
    "playwright-report",
    "test-results",
    "my-playwright-project",
    "app_backup",
    "Ironboard",
    "Ironleads",
    "SalesTeam",
    "SuccessTeam",
    "SupportTeam",
    "scripts",
    "tests",
    "__tests__",
    "testing",
    "docs",
    "doc",
    "public",
    "public copy",
    "test_docs",
    "test_docs copy",
    "storage",
    "artifacts",
    "reports",
    "infrastructure",
    "docker",
    "bin",
    "branding",
    "secrets",
    "supabase",
    "logs",
    ".vercel",
    ".pki-provision",
    "**/* copy.*",
    "**/*copy.*"
  ]
}
